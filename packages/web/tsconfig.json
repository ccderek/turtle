{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@turtle/server/api": ["../server/dist/api.d.ts"],
      "@turtle/core": ["../core/dist/index.d.ts"],
      "@turtle/protocol": ["../protocol/dist/index.d.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
